# ────────────────────────────────────────────────────────────
# Btop theme - Gornergrat Station
# Gornergrat Station inspired light theme
# ────────────────────────────────────────────────────────────

# Main background - leave empty for terminal default
theme[main_bg]=""

# Main text color - deep blue-black
theme[main_fg]="#0B1626"

# Title color for boxes - medium blue
theme[title]="#21477A"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#0E2E61"

# Background color of selected item
theme[selected_bg]="#274369"

# Foreground color of selected item
theme[selected_fg]="#CAD0D8"

# Color of inactive/disabled text
theme[inactive_fg]="#536A89"

# Misc colors for processes box
theme[proc_misc]="#19293F"

# Box outline colors - subtle blue
theme[cpu_box]="#536A89"
theme[mem_box]="#536A89"
theme[net_box]="#536A89"
theme[proc_box]="#536A89"

# Box divider line color
theme[div_line]="#A8B2C0"

# Temperature graph colors (cool to hot)
theme[temp_start]="#21477A"
theme[temp_mid]="#536A89"
theme[temp_end]="#8B5A5A"

# CPU graph colors
theme[cpu_start]="#21477A"
theme[cpu_mid]="#274369"
theme[cpu_end]="#0E2E61"

# Memory meters
theme[free_start]="#CAD0D8"
theme[free_mid]="#A8B2C0"
theme[free_end]="#536A89"

theme[cached_start]="#B8C2D0"
theme[cached_mid]="#8FA0B3"
theme[cached_end]="#536A89"

theme[available_start]="#21477A"
theme[available_mid]="#274369"
theme[available_end]="#0E2E61"

theme[used_start]="#536A89"
theme[used_mid]="#274369"
theme[used_end]="#0E2E61"

# Network graph colors
theme[download_start]="#21477A"
theme[download_mid]="#536A89"
theme[download_end]="#A8B2C0"

theme[upload_start]="#274369"
theme[upload_mid]="#536A89"
theme[upload_end]="#A8B2C0"